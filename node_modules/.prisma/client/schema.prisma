generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id                Int                @id @default(autoincrement())
  item_code         String             @unique // e.g. "ITEM001"
  name              String
  brand             String
  category          String
  purchasePrice     Float
  salePrice         Float
  defaultDiscount   Float              @default(0)
  stock             Int                @default(0) // Tracks total units
  unitsPerPack      Int                @default(1) // Total Tablets per Box (stripsPerBox * tabletsPerStrip)
  stripsPerBox      Int                @default(1) // New: How many strips in a box
  tabletsPerStrip   Int                @default(1) // New: How many tablets in a strip
  batches           Batch[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  transfers         Transfer[]
  aliases           ProductAlias[]
  productSuppliers  ProductSupplier[]
  expectedDiscounts ExpectedDiscount[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Branch {
  id            Int        @id @default(autoincrement())
  name          String
  location      String
  type          String // "Main" | "Pharmacy"
  batches       Batch[]
  sales         Sale[]
  purchases     Purchase[]
  users         User[]
  fromTransfers Transfer[] @relation("FromBranch")
  toTransfers   Transfer[] @relation("ToBranch")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Batch {
  id                Int            @id @default(autoincrement())
  batchNo           String
  manufacturingDate DateTime?
  expiryDate        DateTime
  quantity          Int // Tracks total units in this batch
  productId         Int
  product           Product        @relation(fields: [productId], references: [id])
  branchId          Int?
  branch            Branch?        @relation(fields: [branchId], references: [id])
  supplierId        Int?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchasePrice     Float?
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]
  createdAt         DateTime       @default(now())
}

model Sale {
  id           Int        @id @default(autoincrement())
  invoiceNo    String     @unique
  date         DateTime   @default(now())
  total        Float
  tax          Float
  discount     Float      @default(0)
  paidAmount   Float      @default(0)
  changeAmount Float      @default(0)
  items        SaleItem[]
  branchId     Int?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  batchId   Int
  batch     Batch   @relation(fields: [batchId], references: [id])
  quantity  Int // units sold
  price     Float // price per unit sold (strip price or piece price)
  isPiece   Boolean @default(false)
}

model Purchase {
  id         Int            @id @default(autoincrement())
  invoiceNo  String         @unique
  date       DateTime       @default(now())
  total      Float
  supplierId Int
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]
  branchId   Int?
  branch     Branch?        @relation(fields: [branchId], references: [id])
  createdAt  DateTime       @default(now())
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  batchId    Int
  batch      Batch    @relation(fields: [batchId], references: [id])
  quantity   Int
  price      Float
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  phone            String
  email            String
  address          String
  purchases        Purchase[]
  productSuppliers ProductSupplier[]
  batches          Batch[]
  totalOrders      Int               @default(0)
  lastOrder        DateTime?
  createdAt        DateTime          @default(now())
}

model Settings {
  id           Int     @id @default(1)
  pharmacyName String
  ownerName    String
  phone        String
  email        String
  address      String
  logo         String?
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String // expiry, stock
  title     String
  message   String
  severity  String // critical, warning, info
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Transfer {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  fromBranchId Int
  fromBranch   Branch   @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranchId   Int
  toBranch     Branch   @relation("ToBranch", fields: [toBranchId], references: [id])
  quantity     Int
  batchNo      String
  date         DateTime @default(now())
  status       String // "Completed", "Pending"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String // "Admin" | "Staff"
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
}

// ================= NEW OCR & MATCHING TABLES =================

model OCRInvoice {
  id           Int       @id @default(autoincrement())
  invoiceNo    String
  supplierName String?
  invoiceDate  DateTime?
  totalAmount  Float?
  rawText      String? // Raw OCR text for reference
  status       String    @default("pending") // pending, matched, reviewed
  items        OCRItem[]
  createdAt    DateTime  @default(now())
}

model OCRItem {
  id               Int        @id @default(autoincrement())
  ocrInvoiceId     Int
  ocrInvoice       OCRInvoice @relation(fields: [ocrInvoiceId], references: [id])
  rawName          String // Name as read from OCR
  matchedProductId Int? // Linked product after matching
  quantity         Int?
  unitPrice        Float?
  discount         Float?
  totalPrice       Float?
  batchNo          String?
  expiryDate       DateTime?
  status           String     @default("unmatched") // unmatched, matched, manual
  createdAt        DateTime   @default(now())
}

model ProductAlias {
  id        Int      @id @default(autoincrement())
  alias     String   @unique // OCR alternate name
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model ExpectedDiscount {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  supplierName String?
  discountPct  Float // Expected discount percentage
  bonusQty     String? // e.g. "10+2" bonus scheme
  notes        String?
  createdAt    DateTime @default(now())
}

model ProductSupplier {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  purchasePrice Float
  discount      Float    @default(0)
  lastUpdated   DateTime @updatedAt

  @@unique([productId, supplierId])
}
